# ========================================================
# Lunabria Environment Configuration Template
# ========================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
#
# The systemd installer (bash systemd/install.sh) requires these
# variables to be present, either here in .env or exported in the
# shell environment: HOST, PORT, APP_DATA_DIR, CALIBRE_LIBRARY_PATH,
# APP_STATE_DB_PATH. If any is missing, the installer aborts and
# names the missing variable.

# Server Network Binding
# Default service bind is localhost; use 0.0.0.0 to expose the app
# on all network interfaces (e.g. LAN access without a reverse proxy).
HOST=127.0.0.1
PORT=8000
SSL_PORT=8443

# Application Data Directory (stores SQLite db, uploads, converted PDFs)
# Default: ./data
APP_DATA_DIR=./data

# Calibre Library Path (directory containing metadata.db)
# Default: ./data/calibre_library
# Notes:
# - Windows users: Calibre requires library paths under 75 characters.
# - Cloud sync: Avoid hosting library on active Google Drive/OneDrive/Dropbox folders.
# - Concurrency: Close Calibre desktop before uploading or modifying books.
CALIBRE_LIBRARY_PATH=./data/calibre_library

# Application State Database Path (reading progress, highlights, drawings)
# Default: ./data/app_state.db
APP_STATE_DB_PATH=./data/app_state.db

# Calibre CLI Executables (uncomment to override if not in system PATH)
# CALIBREDB_BIN=calibredb
# EBOOK_CONVERT_BIN=ebook-convert
# FETCH_METADATA_BIN=fetch-ebook-metadata

# ------------------------------------------------------------------
# Installer options (bash systemd/install.sh)
# These override the installer defaults and are read from the shell
# environment when running the installer, e.g.:
#   LUNABRIA_VENV=/opt/venv bash systemd/install.sh
# ------------------------------------------------------------------
# LUNABRIA_VENV=/path/to/venv
# LUNABRIA_PYTHON=/usr/bin/python3
# LUNABRIA_ENV_FILE=/etc/lunabria/.env
# LUNABRIA_REQUIRED_VARS="HOST PORT APP_DATA_DIR CALIBRE_LIBRARY_PATH APP_STATE_DB_PATH"