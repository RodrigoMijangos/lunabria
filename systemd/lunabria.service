[Unit]
Description=Lunabria Backend Service
After=network.target

[Service]
Type=simple
# User and Group under which the service runs
User=www-data
Group=www-data

# Replace /opt/lunabria with the absolute path to your repository clone,
# or simply run: bash systemd/install.sh to configure automatically.
WorkingDirectory=/opt/lunabria/backend
Environment="PATH=/opt/lunabria/backend/.venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/opt/lunabria/backend/.venv/bin/hypercorn app.main:app --bind 127.0.0.1:8000 --access-logfile - --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
